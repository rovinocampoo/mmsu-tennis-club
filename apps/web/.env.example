# Server-side Go API address used by the public training schedule.
# Keep this variable server-only (do not prefix it with NEXT_PUBLIC_).
API_BASE_URL=http://localhost:8080

# Server-only shared secret for authenticating Next.js proxy client-IP metadata.
# Configure the same random value as API_PROXY_SHARED_SECRET in the Go API.
API_PROXY_SHARED_SECRET=

# Browser-visible Supabase project URL and publishable key for admin password sign-in.
# These are public project settings, never service-role or database credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Or use NEXT_PUBLIC_SUPABASE_ANON_KEY for a project still using the legacy key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
