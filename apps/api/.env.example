# Optional bind host. Leave empty to preserve the existing all-interface bind.
# Use 127.0.0.1 for local-only testing.
API_HOST=

# Port used by the HTTP server (defaults to 8080).
PORT=8080

# Shared secret used only between the Next.js proxy and this API.
# Configure the same random value in both deployments; use at least 32 characters.
API_PROXY_SHARED_SECRET=

# PostgreSQL connection URL for the server-side Go API.
# Configure a dedicated LOGIN role that is a member of mmsu_booking_api
# (and mmsu_schedule_reader for schedule reads). Do not use postgres or service_role.
# Provision the role/password outside these migrations and grant only membership.
# Never grant the API login membership in either function-owner role.
# Set its password securely outside Git and keep this connection server-side only.
DATABASE_URL=

# Separate server-only LOGIN role for admin review functions. Grant membership
# only in mmsu_booking_admin_api (not either function-owner role). Do not reuse the
# public API login or use postgres/service_role credentials.
ADMIN_DATABASE_URL=

# Admin APIs validate each bearer access token with Supabase Auth's /auth/v1/user.
# These settings are server-only. Use the project's publishable key or legacy anon key;
# never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternatively use SUPABASE_ANON_KEY for projects still using the legacy key.
SUPABASE_ANON_KEY=
# Comma-separated Supabase Auth user UUIDs. Provision users in Supabase Auth first.
ADMIN_USER_IDS=
# Comma-separated Supabase Auth user UUIDs authorized to submit coach availability.
COACH_USER_IDS=

# Optional server-only Resend configuration for approved-request email notices.
# Set both values to enable sending; use a sender address verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
